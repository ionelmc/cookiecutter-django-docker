django~={{ cookiecutter.__django_version }}.0

# project deps


# bare minimum stuff
django-admin-utils
django-crispy-forms
django-removals
django-settings-export
lazy_object_proxy
niquests[brotli,http3]
python-dateutil
sentry-sdk
tzdata

# connectors
psycopg[c]
pymemcache

# container tooling
holdup
pysu

# django specific debug tooling
django-debug-toolbar
django-extensions
django-rosetta
django-silk
werkzeug

# for sql logging
sqlparse
colorama

# generic debugging
hunter

# ipdb
ipdb

# cron
cronstable[speedups]

{%- if cookiecutter.worker == 'rq' %}
# rq worker
rq
django-rq
{%- elif cookiecutter.worker == 'celery' %}
# celery worker
celery[redis]
django-celery-results
{%- endif %}

uwsgi
uwsgitop
django-uwsgi-admin
